# このファイルをコピーして local/terraform.tfvars として使う（git管理外）。
#
#   cp terraform.tfvars.example local/terraform.tfvars
#   terraform plan -var-file=local/terraform.tfvars
#
# ADR-0002: 実値はリポジトリにコミットしない。
# CI/CDからは TF_VAR_name_prefix などの環境変数（GitHub Secrets）で渡す。

# 全リソース名の接頭辞。S3バケット名がグローバルに一意になるよう、
# 推測されにくい文字列を含める
name_prefix = "plat-CHANGEME"

region = "ap-northeast-1"

github_owner = "moonlight4617"

# ALBへのインバウンドを許可するCIDR。
# ADR-0013によりタスクはパブリックサブネットに置くため、
# 実験中は自分のグローバルIPに絞ることを強く推奨する
# （確認: curl -s https://checkip.amazonaws.com）
alb_allowed_ingress_cidrs = ["203.0.113.10/32"]

vpc_cidr = "10.20.0.0/16"
az_count = 2
